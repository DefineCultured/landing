{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "definecultured-web",
  "compatibility_date": "2026-09-11",
  "routes": [
    {
      "pattern": "definecultured.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public/",
    "not_found_handling": "404-page"
  }
}
